generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  slug               String               @unique
  created_by         String?              @db.Uuid
  join_code          String?
  tier               String               @default("BASIC")
  transparency_mode  Boolean              @default(false)
  category           String?              @default("Town Union")
  description        String?
  meeting_frequency  String?              @default("Monthly")
  currency           String?              @default("NGN")
  rules              Json?                @default("{\"minAge\": 18, \"requiredGender\": \"ALL\", \"requiredNationality\": \"Nigerian\"}")
  is_verified_identity Boolean            @default(false)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @updatedAt @db.Timestamptz(6)

  members            OrganizationMember[]
  dues               Due[]
  transactions       Transaction[]
  notifications      Notification[]
  verification_codes VerificationCode[]

  @@map("organizations")
}

model OrganizationMember {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String       @db.Uuid
  user_id         String       @db.Uuid
  role            String       @default("MEMBER")
  joined_at       DateTime     @default(now()) @db.Timestamptz(6)

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, user_id])
  @@map("organization_members")
}

model Due {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  title           String
  amount          Decimal       @db.Decimal(12, 2)
  due_date        DateTime      @db.Date
  penalty_type    String?       @default("NONE")
  created_at      DateTime      @default(now()) @db.Timestamptz(6)

  organization    Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  transactions    Transaction[]

  @@map("dues")
}

model Transaction {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String       @db.Uuid
  due_id          String?      @db.Uuid
  created_by      String?      @db.Uuid
  title           String
  amount          Decimal      @db.Decimal(12, 2)
  type            String       @default("INFLOW")
  category        String?      @default("Dues Payment")
  payment_method  String?      @default("CARD")
  reference       String?
  created_at      DateTime     @default(now()) @db.Timestamptz(6)

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  due             Due?         @relation(fields: [due_id], references: [id], onDelete: SetNull)

  @@map("transactions")
}

model Notification {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String       @db.Uuid
  title           String
  message         String
  is_read         Boolean      @default(false)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model VerificationCode {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String       @db.Uuid
  code            String
  role            String       @default("MEMBER")
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  expires_at      DateTime?    @db.Timestamptz(6)
  used_at         DateTime?    @db.Timestamptz(6)

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("verification_codes")
}
